# Copy to .env and fill in. .env is never versioned.

# JWT signing key. Generate one, do not reuse this placeholder.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/captable
DB_HOST=localhost
DB_PORT=5432
DB_USER=<user>
DB_PASSWORD=<password>

# Runtime. Anything other than "production" opens /docs and /redoc.
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap company, read by scripts/seed_admin.py
COMPANY_NAME=TechStartup SAS
COMPANY_AUTHORIZED_SHARES=1000000

# Bootstrap admin, read by scripts/seed_admin.py only.
# The API never creates accounts on startup: run the script knowingly, once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_ROLE=admin
ADMIN_NAME=Admin User
